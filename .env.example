# Copy to .env.local and fill in. Never commit .env.local.

# Supabase (Project Settings -> API). Legacy anon / service_role keys also work.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# OpenAI (live English subtitles on the dashboard).
OPENAI_API_KEY=

# Vapi (calls). Assistant ids are printed by `node scripts/sync-agents.mjs` on first run.
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
VAPI_TENANT_ASSISTANT_ID=
VAPI_DISPATCHER_ASSISTANT_ID=
# Shared secret Vapi sends with every webhook (X-Vapi-Secret), so strangers can't hit it
VAPI_WEBHOOK_SECRET=
# Voice agent settings used by scripts/sync-agents.mjs
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5
VAPI_MODEL=gpt-4.1-mini
DEEPGRAM_LANGUAGE=multi

# Twilio (SMS). Use either a From number or a Messaging Service.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# Booking confirmation by email (Gmail + app password). CONFIRMATION_EMAIL_TO = the demo tenant's inbox.
GMAIL_USER=
GMAIL_APP_PASSWORD=
CONFIRMATION_EMAIL_TO=

# Public URL of this app (Vercel URL, or an ngrok URL while developing)
PUBLIC_BASE_URL=
# Phone alerted on emergencies and when no contractor books
ONCALL_MANAGER_PHONE=
# Unlocks the dashboard's Reset / backup Dispatch buttons: open /?key=<this>
DASHBOARD_ADMIN_KEY=
# Optional: shown on the impact card as the comparison, e.g. "3 days". Leave empty until you have a real figure.
NEXT_PUBLIC_TYPICAL_RESPONSE=
# Time zone for every time a person hears or reads
DEMO_TIME_ZONE=Europe/Amsterdam

# scripts/simulate-demo.mjs and fake-tool-call.mjs only
DEMO_TENANT_PHONE=
WEBHOOK_BASE_URL=http://localhost:3000
