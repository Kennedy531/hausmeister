# Copy to .env.local and fill in. Never commit .env.local.

# Supabase (Project Settings -> API). Legacy anon / service_role keys also work.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# OpenAI (photo analysis)
OPENAI_API_KEY=

# Vapi (calls). The ElevenLabs voice is configured inside Vapi.
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
VAPI_DISPATCHER_ASSISTANT_ID=
# Shared secret Vapi sends with every tool call, so strangers can't hit the webhook
VAPI_WEBHOOK_SECRET=

# Twilio (SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Public URL of this app (Vercel URL, or an ngrok URL while developing)
PUBLIC_BASE_URL=
# Phone alerted on emergencies (gas, fire, water near electrics)
ONCALL_MANAGER_PHONE=

# Track A testing only: the phone the mock dispatch_contractor calls before Track B's real tool lands
MOCK_CONTRACTOR_PHONE=
